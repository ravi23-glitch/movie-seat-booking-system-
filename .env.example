# Environment variables configuration
NODE_ENV=development
PORT=3000

# PostgreSQL Connection String (compatible with local PostgreSQL or Docker Compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movietickets?schema=public"

# Authentication
JWT_SECRET="cinema-super-secret-jwt-key-2026-production-grade"
JWT_EXPIRES_IN="7d"

# Reservation Engine Settings
SEAT_LOCK_DURATION_MINUTES=10
CLEANUP_INTERVAL_SECONDS=60
MAX_SEATS_PER_BOOKING=6
